# URL Base de la API del Backend:
# - Para desarrollo local: /api/v1 (usa el proxy de vite) o http://localhost:3000/api/v1
# - Para despliegue en Vercel con backend en Render: https://<tu-backend>.onrender.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Entorno de SUNAT activo: BETA (Homologación/Pruebas) | PRODUCCION (Emisión Real)
VITE_SUNAT_ENV=BETA

# Nombre e Identificador del Sistema
VITE_APP_NAME=SYNC-SUNAT
