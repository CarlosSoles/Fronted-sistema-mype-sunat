/*
 * El index.html nunca debe reutilizarse desde caché: es el que referencia los
 * assets con hash. Si se sirve uno viejo, el navegador pide archivos que ya no
 * existen y Cloudflare responde con el propio HTML (text/html), dejando la
 * aplicación en blanco.
 */
/index.html
  Cache-Control: no-store

/
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
